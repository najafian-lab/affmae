# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# Loaded automatically by affmae/utils/env.py at driver startup. Values already
# present in the environment always win, so `export WANDB_API_KEY=...` or
# `wandb login` overrides whatever is here.

# Weights & Biases API key, from https://wandb.ai/authorize
# Leave blank and set `wandb_enabled: false` in your config to train without it.
WANDB_API_KEY=

# W&B destination. These default to the values baked into the training scripts;
# override them to log into your own account rather than the paper's project.
WANDB_ENTITY=
WANDB_PROJECT=

# ---------------------------------------------------------------------------
# Paths. Every one of these defaults to a directory beside the repository root,
# so a fresh clone works with nothing set: put the data in ./data and the
# weights in ./weights, or point these somewhere else. A relative value is
# resolved against the repository root, not your shell's cwd.
# ---------------------------------------------------------------------------

# Pretrained checkpoints. Configs read ${CHECKPOINT_ROOT:-weights}/pretrain/...
# so the expected layout is:
#     weights/pretrain/       backbones that finetuning starts from
#     weights/segmentation/   finetuned checkpoints
CHECKPOINT_ROOT=

# Dataset root. Every config reads ${DATA_ROOT:-data}/..., so the expected
# layout is:
#     data/pretrain/          WebDataset .tar shards for pretraining
#     data/finetune/          train|val|test, each with images/ and masks/
#     data/fpwdata/           the paper's FPW dataset, same split layout
# Defaults to ./data, which may be a symlink to storage elsewhere.
# See docs/custom_data.md.
DATA_ROOT=

# Where runs write checkpoints, logs and figures. Defaults to ./output
AFFMAE_OUTPUT_DIR=
